  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "outDir": ".test-build"
  },
  "include": ["tests/**/*.ts", "lib/**/*.ts", "data/**/*.json"],
  "exclude": ["lib/crm-access.ts"]
}

